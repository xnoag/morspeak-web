# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# MCP config (contains API keys)
.mcp.json

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 영상 편집 원본은 git 에 넣지 않는다 (iCloud 04-미디어/01-영상 에 보관)
*.mov

### Firestore 규칙 테스트 ###
firestore/tests/node_modules
firestore/tests/firestore-debug.log
firestore/tests/*-debug.log
