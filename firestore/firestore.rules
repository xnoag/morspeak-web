// Morspeak Firestore 보안 규칙 — 1단계 (전면 개방 해제)
//
// ⚠️ 아직 배포하지 않았다. 배포는 `firebase deploy --only firestore:rules`.
//    배포 즉시 전 클라이언트에 적용된다. 경로를 하나 빠뜨리면 그 기능이 죽는다.
//    되돌리려면 firestore.rules.CURRENT-BASELINE 을 배포하면 된다(30초).
//    반드시 환자 아이패드 1대를 켜둔 상태에서 배포하고, 아래 체크리스트를 확인할 것.
//
// ── 배경 ────────────────────────────────────────────────────────────────
// 2026-09-07 시점 배포돼 있던 규칙은 Firebase 기본 테스트 모드였고 만료일만 2040년으로
// 밀어놓은 상태였다:  match /{document=**} { allow read, write: if request.time < 2040-08-30 }
// = 인증 없이 누구나 전체 DB 를 읽고 쓰고 지울 수 있었다.
// 확인: 토큰 없이 존재하지 않는 문서를 요청하면 403 이 아니라 404 가 돌아왔다.
//
// ── 이 규칙이 하는 것 / 못 하는 것 ──────────────────────────────────────
// 어떤 클라이언트도 인증을 하지 않는다(앱 6종·웹 전부, App Check 도 미설정).
// 그래서 request.auth / request.app 으로 정상 사용자와 공격자를 구분할 방법이 없다.
// 이 단계에서 할 수 있는 것은 두 가지뿐이다.
//
//   1. 와일드카드 제거 → 알려진 경로만 허용. 임의 컬렉션에 쓰레기를 쓰거나
//      새 컬렉션을 만들어 스토리지·요금을 태우는 것을 막는다.
//   2. 실제로 쓰이지 않는 operation 차단 — 특히 list(목록 조회).
//      list 를 막으면 그 컬렉션은 "문서 ID 를 정확히 알아야" 읽을 수 있다.
//      전수 수집(enumeration)이 불가능해진다.
//
// 못 하는 것: 아이디/코드를 아는 사람의 접근은 여전히 막지 못한다.
// 근본 해결은 2단계(웹 읽기를 서버 사이드로) + 3단계(App Check / Firebase Auth)다.
//
// ── list 를 허용해야 하는 곳 (코드에서 전수 조사한 결과) ──────────────
//   앱   chats/{code}/messages          order(by: clientTimestamp), limit(1)
//        usageStats/{code}/speaks, /youtubeSearches, /sessions
//        deviceTokens/{token}/logs/{type}/items
//   케어앱 caregiverTokens, chats/{code}/messages
//   웹   usageStats, waitlist, patients, training_slots, schedule_slots,
//        screening_results, qualitative_scores, orgs, equipment_loans,
//        chats, call_notes
//
// ── list 를 막는 곳 (아무 클라이언트도 목록 조회하지 않음) ────────────
//   featureFlags       ← 여기가 열려 있으면 환자의 「호출」 버튼을 원격으로 끌 수 있다
//   tutorialConfig     blinkProfiles      shortcuts
//   educationSessions  youtubeSuggestions snapshotRequests  deviceStatus
//   deviceTokens(루트)
//
// ✅ patients 와 usageStats 의 list 도 닫았다(2026-09-07).
//    웹이 where('chatCode','==',code) 로 조회하던 것을 usageStats/{chatCode}.loginId 를
//    거쳐 getDoc(patients/{loginId}) 하도록 바꿨다. 운영 DB 대조로 동등함을 확인했다:
//    patients 24건 / usageStats 99건, loginId 있는 24건은 patients 100% 존재,
//    없는 75건은 chatCode 쿼리로도 못 찾는다(patients 문서 자체가 없음).

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 환자 계정 — list 차단 ─────────────────────────────────────
    // 문서 ID = loginId. 평문 비밀번호가 아직 여기 있다(Auth 이관 전)이므로
    // 전수 수집을 반드시 막아야 한다.
    // 웹이 where('chatCode','==',code) 로 조회하던 것을
    // usageStats/{chatCode}.loginId → getDoc(patients/{loginId}) 로 바꿔서 list 가 불필요해졌다
    // (morspeak-web: patient-report/[code], tracking/patients/[code]).
    match /patients/{loginId} {
      allow get: if true;
      allow create, update: if true;
      allow delete: if true;   // 웹 계정 삭제 플로우
      allow list: if false;
    }

    // ── 사용 통계 + 환자 정보(대시보드 식별용) ────────────────────
    // upsertPatientInfo 가 여기에 쓴다. 비밀번호는 2026-09-07 커밋 b5a9bb8 로 제거됨.
    // 기존 문서에 남아있는 password 필드는 정리 스크립트가 필요하다.
    // 루트 list 차단 — 웹은 getDoc(usageStats/{code}) 와 하위 컬렉션 조회만 쓴다.
    // 환자 실명·생년월일·진단명·병원·보호자 연락처가 여기 있다.
    match /usageStats/{code} {
      allow get: if true;
      allow create, update: if true;
      allow delete: if true;   // 웹 계정 삭제 플로우
      // 🔴 **여기는 아직 열려 있다. 닫으려다 운영 화면을 깨뜨려서 되돌렸다 (2026-09-07 밤).**
      //   `list: if false` 로 배포했더니 트래킹 대시보드(`app/tracking/dashboard/page.tsx`)가
      //   빈 화면이 됐다. 그 화면은 **환자 명단** 이고 루트 전수 조회가 그 자체로 기능이다.
      //   2단계에서 닫은 것은 환자 **상세** 조회(where 쿼리 → getDoc 두 번)였고,
      //   명단 화면은 대조 목록에서 빠져 있었다.
      //
      //   지금 노출: 환자 실명·생년월일·진단명·병원·보호자 연락처가 전수 수집 가능하다.
      //   ⚠️ 어제까지는 DB 전체가 읽기·쓰기 개방이었으므로 **그보다 나쁘지는 않다.**
      //      하지만 이건 고쳐야 할 구멍으로 남는 것이다 — 못 본 척하지 말 것.
      //
      //   진짜 해결(3단계): 대시보드를 **서버 사이드 API**로 옮긴다. `admin_session` 쿠키로
      //   막힌 라우트에서 Admin SDK 로 읽으면 클라이언트에 list 권한이 필요 없어진다.
      //   Vercel 에 서비스 계정 키를 넣어야 해서 대표 승인이 필요하다.
      //   (`patients` 의 list 는 계속 닫혀 있다 — 평문 비밀번호가 있는 쪽이라 더 위험하다)
      allow list: if true;
      match /daily/{day}            { allow read, write: if true; }
      match /sessions/{sessionId}   { allow read, write: if true; }
      match /speaks/{speakId}       { allow read, write: if true; }
      match /youtubeSearches/{sid}  { allow read, write: if true; }
    }

    // ── 채팅 ───────────────────────────────────────────────────────
    match /chats/{code} {
      allow get, list: if true;
      allow create, update: if true;
      allow delete: if true;
      match /messages/{messageId} { allow read, write: if true; }
    }

    // ── 기능 플래그 — list 차단 ────────────────────────────────────
    // 원격으로 환자 버튼을 켜고 끄는 값이다. 전수 조회를 막는다.
    match /featureFlags/{code} {
      allow get: if true;
      allow create, update: if true;
      allow list, delete: if false;
    }

    // ── 튜토리얼 원격 제어 — list 차단 ────────────────────────────
    match /tutorialConfig/{code} {
      allow get: if true;
      allow create, update: if true;
      allow list, delete: if false;
    }

    // ── 깜빡임 학습 프로필 — list 차단 ────────────────────────────
    match /blinkProfiles/{code} {
      allow get: if true;
      allow create, update: if true;
      allow list: if false;
      allow delete: if true;   // 웹 계정 삭제 플로우
    }

    // ── 단축어 — list 차단 ────────────────────────────────────────
    match /shortcuts/{code} {
      allow get: if true;
      allow create, update: if true;
      allow list: if false;
      allow delete: if true;   // 웹 계정 삭제 플로우
    }

    // ── 교육 세션 / 유튜브 추천 / 스냅샷 요청 / 기기 상태 — list 차단 ──
    match /educationSessions/{code} {
      allow get: if true; allow create, update: if true; allow list, delete: if false;
    }
    match /youtubeSuggestions/{code} {
      allow get: if true; allow create, update: if true; allow list: if false;
      allow delete: if true;   // 웹 계정 삭제 플로우
    }
    match /snapshotRequests/{code} {
      allow get: if true; allow create, update: if true;
      allow delete: if true;   // 앱이 처리 후 스스로 지운다
      allow list: if false;
    }
    match /deviceStatus/{code} {
      allow get: if true; allow create, update: if true; allow list, delete: if false;
    }

    // ── 기기 토큰(FCM) ────────────────────────────────────────────
    // 루트 list 는 막고, 하위 logs/items 는 앱이 조회하므로 허용.
    match /deviceTokens/{token} {
      allow get: if true;
      allow create, update: if true;
      allow list: if false;
      allow delete: if true;
      match /logs/{logType} {
        allow read, write: if true;
        match /items/{itemId} { allow read, write: if true; }
      }
    }

    // ── 보호자앱 토큰 ─────────────────────────────────────────────
    match /caregiverTokens/{tokenId} { allow read, write: if true; }

    // ── 판별앱 ────────────────────────────────────────────────────
    match /screening_results/{resultId} { allow read, write: if true; }

    // ── 웹 전용 컬렉션 ────────────────────────────────────────────
    match /waitlist/{itemId}           { allow read, write: if true; }
    match /applications/{itemId}       { allow read, write: if true; }
    match /survey_responses/{itemId}   { allow read, write: if true; }
    match /review_sessions/{itemId}    { allow read, write: if true; }
    match /qualitative_scores/{itemId} { allow read, write: if true; }
    match /call_notes/{itemId}         { allow read, write: if true; }
    match /schedule_slots/{itemId}     { allow read, write: if true; }
    match /training_slots/{itemId}     { allow read, write: if true; }
    match /equipment_loans/{itemId}    { allow read, write: if true; }
    match /donation_messages/{itemId}  { allow read, write: if true; }

    // ── 웹 문의 폼 (/contact · /eng·/jpn 뉴스레터) ─────────────────
    // create 만 검증한다. **공개 폼이라 아무나 쓸 수 있는 유일한 입구**이므로
    // 필드 이름과 길이를 제한해 스팸이 저장소·요금을 갉아먹는 것을 막는다.
    // (다른 웹 컬렉션은 검증이 없다 — 새로 만드는 이 컬렉션만이라도 조여 둔다)
    //
    // ⚠️ read 가 열려 있다. 관리자 페이지(/admin/inquiries)가 클라이언트에서
    //    목록을 읽기 때문이다. 담당자명·전화번호가 들어오므로 Firestore 보안
    //    2단계에서 **이 컬렉션을 반드시 같이 조여야 한다** (서버 라우트로 옮기거나 인증).
    //    지금 열어두는 건 기존 waitlist·applications 와 같은 수준이라는 뜻일 뿐이다.
    function isValidInquiry() {
      let d = request.resource.data;
      return d.keys().hasOnly(['kind', 'organization', 'name', 'phone', 'email',
                               'message', 'locale', 'handled', 'note', 'createdAt'])
        && d.keys().hasAll(['kind', 'createdAt'])
        && (d.kind == 'contact' || d.kind == 'newsletter')
        // serverTimestamp() 만 허용 — 날짜를 조작해 목록 앞에 끼워넣지 못하게 한다
        && d.createdAt == request.time
        && (!('organization' in d) || (d.organization is string && d.organization.size() <= 100))
        && (!('name' in d)         || (d.name is string && d.name.size() <= 50))
        && (!('phone' in d)        || (d.phone is string && d.phone.size() <= 30))
        && (!('email' in d)        || (d.email is string && d.email.size() <= 200))
        && (!('message' in d)      || (d.message is string && d.message.size() <= 2000))
        && (!('locale' in d)       || (d.locale is string && d.locale.size() <= 10))
        && (!('note' in d)         || (d.note is string && d.note.size() <= 2000))
        && (!('handled' in d)      || d.handled == false);
    }
    match /inquiries/{itemId} {
      allow create: if isValidInquiry();
      allow read: if true;             // 관리자 페이지 목록 — 위 경고 참조
      allow update, delete: if true;   // 처리 표시·메모·삭제
    }

    // ── 아산나눔재단 정산 — 유일하게 인증이 걸린 영역 ─────────────
    // 이쪽은 Firebase 이메일 링크 인증(lib/receiptAuth.ts)을 쓴다.
    // firestore.receipts.rules.draft.txt 의 내용을 그대로 반영했다.
    function isMember(orgId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/memberships/$(request.auth.uid + '_' + orgId));
    }

    match /orgs/{orgId} {
      allow read: if isMember(orgId);
      allow create: if request.auth != null && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false;

      match /budgetItems/{itemId} {
        allow read, write: if isMember(orgId);
        match /evidenceFiles/{fileId} { allow read, write: if isMember(orgId); }
      }
    }

    match /memberships/{membershipId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── 그 외 모든 경로: 차단 ─────────────────────────────────────
    // 와일드카드를 없앤 것이 이 규칙의 핵심이다. 알려지지 않은 컬렉션에는
    // 아무도 쓸 수 없다.
  }
}
